{
  "name": "notyra-toc",
  "version": "1.0.0",
  "type": "module",
  "description": "A live Markdown table of contents for Notyra",
  "author": "Yuma Shintani",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "package": "node ../../scripts/package-plugin.mjs ."
  },
  "dependencies": {
    "remark": "15.0.1"
  },
  "devDependencies": {
    "@notyra/plugin-api": "https://codeload.github.com/yuma-shin/notyra-plugin-api/tar.gz/3f15cc1f4d516081b1b3c6815239d5d8f59e22ba",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "jsdom": "30.1.3"
  },
  "notyra": {
    "displayName": "Table of Contents / 目次",
    "type": "feature",
    "notyraVersion": "^4.0.0",
    "main": "dist/index.js",
    "permissions": [],
    "settings": [
      {
        "key": "maxDepth",
        "title": "Maximum heading level / 見出しの深さ",
        "type": "number",
        "default": 3
      },
      {
        "key": "includeTitle",
        "title": "Include H1 / H1 を含める",
        "type": "boolean",
        "default": false
      },
      {
        "key": "showLineNumbers",
        "title": "Show line numbers / 行番号を表示",
        "type": "boolean",
        "default": false
      }
    ]
  }
}
